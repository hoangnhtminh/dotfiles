/* Bảng màu "Ember" cho rofi. Giữ đồng bộ với colors/theme.css và hypr/conf/colors.lua */
* {
    background:      #1a1512;
    background-alt:  #241c17;
    foreground:      #e8d5c4;
    sub:             #b89880;
    gray:            #7a5c45;
    selected:        #3a2c22;

    orange:  #e8824a;
    orange2: #c4683a;
    yellow:  #e8c24a;
    red:     #e85a4a;
    green:   #8ac44a;
    blue:    #4a98e8;
    purple:  #9a4ae8;

    bordercolor: #e8824a;
}
