{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "color": { "1": "38;5;208" }, "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "38;5;208", "title": "38;5;214" } },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": " OS     " },
    { "type": "kernel",   "key": " Kernel " },
    { "type": "shell",    "key": " Shell  " },
    { "type": "wm",       "key": " WM     " },
    { "type": "terminal", "key": " Term   " },
    { "type": "cpu",      "key": " CPU    " },
    { "type": "memory",   "key": " RAM    " },
    { "type": "swap",     "key": " Swap   " },
    { "type": "uptime",   "key": " Uptime " },
    "break",
    { "type": "colors", "paddingLeft": 0, "symbol": "circle" }
  ]
}
