// Waybar — thanh trên cùng, tối giản.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left":   ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["tray", "pulseaudio", "custom/sunset", "custom/dnd", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": false,
        "show-special": false,
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - Brave": "  $1",
            "(.*)nvim(.*)": "  $1"
        }
    },

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰃭  {:%a, %d %b %Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#e8824a'><b>{}</b></span>",
                "days":     "<span color='#e8d5c4'>{}</span>",
                "weekdays": "<span color='#b89880'><b>{}</b></span>",
                "today":    "<span color='#e8824a'><b><u>{}</u></b></span>"
            }
        },
        "on-click-right": "~/.config/scripts/wallpaper.sh pick"
    },

    "tray": { "icon-size": 16, "spacing": 8, "show-passive-items": false },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Tắt",
        "format-icons": { "headphone": "󰋋", "headset": "󰋎", "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,
        "max-volume": 150,
        "tooltip-format": "{desc} — {volume}%"
    },

    "custom/sunset": {
        "exec": "~/.config/scripts/sunset-toggle.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/scripts/sunset-toggle.sh toggle"
    },

    "custom/dnd": {
        "exec": "~/.config/scripts/dnd.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/scripts/dnd.sh toggle",
        "on-click-right": "makoctl restore"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Menu nguồn",
        "on-click": "~/.config/scripts/powermenu.sh"
    }
}
