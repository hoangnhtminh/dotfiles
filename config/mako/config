# mako — thông báo nhẹ (thay swaync: ~1-2 MB RAM, không cần GTK/CSS động)
font=JetBrainsMono Nerd Font 11
background-color=#241c17f2
text-color=#e8d5c4
border-color=#e8824a
border-size=2
border-radius=6
padding=10
margin=10
width=340
height=140
icons=1
max-icon-size=40
icon-path=/usr/share/icons/Papirus-Dark
layer=overlay
anchor=top-right
max-visible=4
default-timeout=5000
ignore-timeout=0
markup=1
actions=1
format=<b>%s</b>\n%b
group-by=app-name

[urgency=low]
border-color=#7a5c45
default-timeout=3000

[urgency=high]
border-color=#e85a4a
default-timeout=0

[mode=do-not-disturb]
invisible=1
