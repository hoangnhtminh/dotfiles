/* Theme rofi dùng chung. Các theme khác chỉ import file này rồi ghi đè vài dòng. */
@import "~/.config/colors/color.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @foreground;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 560px;
    background-color: @background;
    border: 2px;
    border-color: @bordercolor;
    border-radius: 8px;
}

mainbox {
    padding: 14px;
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 12px;
    spacing: 10px;
    background-color: @background-alt;
    border-radius: 6px;
    children: [ prompt, entry ];
}
prompt { text-color: @orange; }
entry  { placeholder: "Tìm…"; placeholder-color: @gray; }

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 8px 10px;
    spacing: 10px;
    border-radius: 6px;
}
element selected.normal   { background-color: @selected; text-color: @orange; }
element selected.active   { background-color: @selected; text-color: @orange; }
element normal.urgent,
element alternate.urgent  { text-color: @red; }
element-icon { size: 24px; background-color: transparent; }
element-text { text-color: inherit; vertical-align: 0.5; }
